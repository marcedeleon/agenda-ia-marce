# =============================================================
# Agenda IA Marce — Configuración de entorno
# Copiá este archivo a `.env` y completá los valores reales.
# NUNCA subas `.env` al repositorio.
# =============================================================

# --- Servidor ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Zona horaria de la agenda (se usa para el resumen diario)
TZ=America/Argentina/Buenos_Aires

# --- PostgreSQL ---
DATABASE_URL=postgresql://agenda:agenda@localhost:5432/agenda_ia?schema=public

# --- WhatsApp Business Cloud API (Meta) ---
# Token de acceso permanente generado en la app de Meta.
META_WA_TOKEN=pegar-token-aqui
# ID del número de teléfono (sin el "whatsapp phone number id" no funciona).
WA_PHONE_NUMBER_ID=000000000000000
# Token de verificación libre que elegís vos para verificar el webhook.
WA_WEBHOOK_VERIFY_TOKEN=elegi-un-token-secreto
# Versión de la Graph API (dejar el default salvo que sepas qué estás haciendo).
WA_GRAPH_API_VERSION=v25.0
# App secret de Meta (si lo configurás, el webhook valida la firma de cada POST).
WA_APP_SECRET=

# --- Google Gemini ---
GEMINI_API_KEY=pegar-api-key-aqui
# Modelo a usar para clasificar y armar las tareas.
GEMINI_MODEL=gemini-2.5-flash

# --- Agenda ---
# Números de WhatsApp autorizados a escribirle al bot (formato internacional, sin "+").
# Separados por coma (máx. 2 por ahora).
AGENDA_OWNERS_WHATSAPP=5491100000000,5491100000001
# Hora del resumen diario (solo hora, formato HH:MM).
DAILY_REMINDER_TIME=08:00